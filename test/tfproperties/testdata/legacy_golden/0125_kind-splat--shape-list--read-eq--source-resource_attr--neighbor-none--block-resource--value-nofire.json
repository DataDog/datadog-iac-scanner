{
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": "${aws_instance.src.items[*].attr}"
     }
    }
   }
  }
 ],
 "src.tf": [
  {
   "file": "src.tf",
   "resource": {
    "aws_instance": {
     "src": {
      "items": [
       {
        "attr": "safe"
       },
       {
        "attr": "x"
       }
      ],
      "probe_source": [
       "safe",
       "x"
      ]
     }
    }
   }
  }
 ]
}