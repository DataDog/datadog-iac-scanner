{
 "main.tf": [
  {
   "file": "main.tf",
   "locals": {
    "src": {
     "probe_source": "fire"
    }
   },
   "module": {
    "m": {
     "in_val": "${aws_instance.src}",
     "source": "./mod"
    },
    "m2": {
     "in_val": {
      "probe_source": "fire"
     },
     "source": "./mod"
    }
   },
   "resource": {
    "aws_s3_bucket": {
     "sink2": {
      "probe": "${module.m2.out_missing}"
     },
     "sink4": {
      "probe": "${module.m.out_missing}"
     }
    }
   }
  }
 ],
 "mod/main.tf": [
  {
   "file": "mod/main.tf",
   "output": {
    "out_missing": {
     "value": "${try(var.in_val.missing, { probe_source = \"fire\" })}"
    },
    "out_val": {
     "value": "${var.in_val}"
    }
   },
   "variable": {
    "in_val": {}
   }
  }
 ],
 "neighbor.tf": [
  {
   "file": "neighbor.tf",
   "resource": {
    "aws_instance": {
     "nbr": {
      "for_each": "${var.unset_value}",
      "probe_source": "nbr"
     }
    }
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": "${module.m.out_val}"
     }
    }
   }
  }
 ],
 "src.tf": [
  {
   "file": "src.tf",
   "resource": {
    "aws_instance": {
     "src": {
      "probe_source": "fire"
     }
    }
   }
  }
 ],
 "unset.tf": [
  {
   "file": "unset.tf",
   "variable": {
    "unset_value": {}
   }
  }
 ]
}