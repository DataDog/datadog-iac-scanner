{
 "data.tf": [
  {
   "data": {
    "probe_data": {
     "src": {
      "value": [
       "safe",
       "x"
      ]
     }
    }
   },
   "file": "data.tf",
   "locals": {
    "val": "${data.probe_data.src.value}"
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": "${local.val}",
      "unrelated": "${var.unset_value}"
     }
    }
   }
  }
 ],
 "unset.tf": [
  {
   "file": "unset.tf",
   "variable": {
    "unset_value": {}
   }
  }
 ]
}