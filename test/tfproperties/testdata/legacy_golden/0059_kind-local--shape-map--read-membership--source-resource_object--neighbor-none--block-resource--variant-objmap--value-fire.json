{
 "locals.tf": [
  {
   "file": "locals.tf",
   "locals": {
    "val": "${aws_instance.src}"
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": "${local.val}"
     }
    }
   }
  }
 ],
 "src.tf": [
  {
   "file": "src.tf",
   "resource": {
    "aws_instance": {
     "src": {
      "probe_source": "fire"
     }
    }
   }
  }
 ]
}