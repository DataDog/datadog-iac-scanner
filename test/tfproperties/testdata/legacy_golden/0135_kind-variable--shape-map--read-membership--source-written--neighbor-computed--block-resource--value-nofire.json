{
 "neighbor.tf": [
  {
   "file": "neighbor.tf",
   "resource": {
    "aws_instance": {
     "src": {
      "probe_source": "x"
     }
    }
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "computed_ref": "${aws_instance.src.id}",
      "probe": {
       "a": "safe",
       "b": "x"
      }
     }
    }
   }
  }
 ],
 "vars.tf": [
  {
   "file": "vars.tf",
   "variable": {
    "val": {
     "default": {
      "a": "safe",
      "b": "x"
     }
    }
   }
  }
 ]
}