{
 "main.tf": [
  {
   "file": "main.tf",
   "module": {
    "m": {
     "source": "./mod"
    }
   }
  }
 ],
 "mod/main.tf": [
  {
   "file": "mod/main.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": "fire"
     }
    }
   },
   "variable": {
    "in_val": {
     "default": "fire"
    }
   }
  }
 ],
 "neighbor.tf": [
  {
   "file": "neighbor.tf",
   "resource": {
    "aws_instance": {
     "nbr": {
      "for_each": "${var.unset_value}",
      "probe_source": "nbr"
     }
    }
   }
  }
 ],
 "unset.tf": [
  {
   "file": "unset.tf",
   "variable": {
    "unset_value": {}
   }
  }
 ]
}