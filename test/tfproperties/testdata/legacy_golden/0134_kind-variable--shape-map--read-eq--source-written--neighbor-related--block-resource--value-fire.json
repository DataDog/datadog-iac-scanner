{
 "neighbor.tf": [
  {
   "file": "neighbor.tf",
   "resource": {
    "aws_s3_bucket_versioning": {
     "rel": {
      "bucket": "${aws_s3_bucket.sink.id}",
      "versioning_configuration": {
       "status": "${var.unset_value}"
      }
     }
    }
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": {
       "a": "fire"
      }
     }
    }
   }
  }
 ],
 "unset.tf": [
  {
   "file": "unset.tf",
   "variable": {
    "unset_value": {}
   }
  }
 ],
 "vars.tf": [
  {
   "file": "vars.tf",
   "variable": {
    "val": {
     "default": {
      "a": "fire"
     }
    }
   }
  }
 ]
}