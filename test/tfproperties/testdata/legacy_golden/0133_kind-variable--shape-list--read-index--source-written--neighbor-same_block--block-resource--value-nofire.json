{
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": [
       "safe",
       "x"
      ],
      "unrelated": "${var.unset_value}"
     }
    }
   }
  }
 ],
 "unset.tf": [
  {
   "file": "unset.tf",
   "variable": {
    "unset_value": {}
   }
  }
 ],
 "vars.tf": [
  {
   "file": "vars.tf",
   "variable": {
    "val": {
     "default": [
      "safe",
      "x"
     ]
    }
   }
  }
 ]
}