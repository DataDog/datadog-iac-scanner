{
 "data.tf": [
  {
   "data": {
    "probe_data": {
     "src": {
      "value": "${aws_instance.src.probe_source}"
     }
    }
   },
   "file": "data.tf",
   "locals": {
    "val": "${data.probe_data.src.value}"
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": "${local.val}",
      "unrelated": "${var.unset_value}"
     }
    }
   }
  }
 ],
 "src.tf": [
  {
   "file": "src.tf",
   "resource": {
    "aws_instance": {
     "src": {
      "probe_source": {
       "a": "fire"
      }
     }
    }
   }
  }
 ],
 "unset.tf": [
  {
   "file": "unset.tf",
   "variable": {
    "unset_value": {}
   }
  }
 ]
}