{
 "neighbor.tf": [
  {
   "file": "neighbor.tf",
   "resource": {
    "aws_instance": {
     "nbr": {
      "for_each": "${var.unset_value}",
      "probe_source": "nbr"
     }
    }
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": {
       "a": "fire"
      }
     }
    }
   }
  }
 ],
 "unset.tf": [
  {
   "file": "unset.tf",
   "variable": {
    "unset_value": {}
   }
  }
 ],
 "vars.tf": [
  {
   "file": "vars.tf",
   "variable": {
    "val": {
     "default": {
      "a": "fire"
     }
    }
   }
  }
 ]
}