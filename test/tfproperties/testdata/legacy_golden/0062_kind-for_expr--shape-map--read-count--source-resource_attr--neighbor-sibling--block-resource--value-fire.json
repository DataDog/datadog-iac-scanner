{
 "neighbor.tf": [
  {
   "file": "neighbor.tf",
   "resource": {
    "aws_instance": {
     "nbr": {
      "for_each": "${var.unset_value}",
      "probe_source": "nbr"
     }
    }
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": "${{ for k, v in aws_instance.src.probe_source : k =\u003e v }}"
     }
    }
   }
  }
 ],
 "src.tf": [
  {
   "file": "src.tf",
   "resource": {
    "aws_instance": {
     "src": {
      "probe_source": {
       "a": "fire"
      }
     }
    }
   }
  }
 ],
 "unset.tf": [
  {
   "file": "unset.tf",
   "variable": {
    "unset_value": {}
   }
  }
 ]
}