{
 "main.tf": [
  {
   "file": "main.tf",
   "module": {
    "m": {
     "in_val": "${aws_instance.src.probe_source}",
     "source": "./mod"
    }
   }
  }
 ],
 "mod/main.tf": [
  {
   "file": "mod/main.tf",
   "output": {
    "out_val": {
     "value": "${var.in_val}"
    }
   },
   "variable": {
    "in_val": {}
   }
  }
 ],
 "neighbor.tf": [
  {
   "file": "neighbor.tf",
   "module": {
    "mUnknown": {
     "in_val": "${var.unset_value}",
     "source": "./mod"
    }
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": "${module.m.out_val}"
     }
    }
   }
  }
 ],
 "src.tf": [
  {
   "file": "src.tf",
   "resource": {
    "aws_instance": {
     "src": {
      "probe_source": {
       "a": "safe",
       "b": "x"
      }
     }
    }
   }
  }
 ],
 "unset.tf": [
  {
   "file": "unset.tf",
   "variable": {
    "unset_value": {}
   }
  }
 ]
}