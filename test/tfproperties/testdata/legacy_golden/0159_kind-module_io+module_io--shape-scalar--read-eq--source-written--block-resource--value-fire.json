{
 "inner.tf": [
  {
   "file": "inner.tf",
   "module": {
    "p": {
     "in_val": "fire",
     "source": "./mod"
    }
   }
  }
 ],
 "main.tf": [
  {
   "file": "main.tf",
   "module": {
    "m": {
     "in_val": "${module.p.out_val}",
     "source": "./mod"
    }
   }
  }
 ],
 "mod/main.tf": [
  {
   "file": "mod/main.tf",
   "output": {
    "out_val": {
     "value": "${var.in_val}"
    }
   },
   "variable": {
    "in_val": {}
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": "${module.m.out_val}"
     }
    }
   }
  }
 ]
}