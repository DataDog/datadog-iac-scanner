{
 "locals.tf": [
  {
   "file": "locals.tf",
   "locals": {
    "val": "${aws_instance.src.probe_source}"
   }
  }
 ],
 "neighbor.tf": [
  {
   "file": "neighbor.tf",
   "resource": {
    "aws_instance": {
     "nbr": {
      "for_each": "${var.unset_value}",
      "probe_source": "nbr"
     }
    }
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": "${local.val}"
     }
    }
   }
  }
 ],
 "src.tf": [
  {
   "file": "src.tf",
   "resource": {
    "aws_instance": {
     "src": {
      "probe_source": [
       "safe",
       "x",
       "y"
      ]
     }
    }
   }
  }
 ],
 "unset.tf": [
  {
   "file": "unset.tf",
   "variable": {
    "unset_value": {}
   }
  }
 ]
}