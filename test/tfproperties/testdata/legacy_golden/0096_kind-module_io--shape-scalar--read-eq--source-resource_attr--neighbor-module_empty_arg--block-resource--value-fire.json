{
 "main.tf": [
  {
   "file": "main.tf",
   "module": {
    "m": {
     "extraArg": "${aws_instance.empty}",
     "in_val": "${aws_instance.src.probe_source}",
     "source": "./mod"
    }
   }
  }
 ],
 "mod/main.tf": [
  {
   "file": "mod/main.tf",
   "output": {
    "out_extra": {
     "value": "${try(var.extraArg.anything, \"fire\")}"
    },
    "out_val": {
     "value": "${var.in_val}"
    }
   },
   "variable": {
    "extraArg": {},
    "in_val": {}
   }
  }
 ],
 "neighbor.tf": [
  {
   "file": "neighbor.tf",
   "resource": {
    "aws_instance": {
     "empty": {}
    }
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": "${module.m.out_val}"
     }
    }
   }
  }
 ],
 "sink3.tf": [
  {
   "file": "sink3.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink3": {
      "probe": "${module.m.out_extra}"
     }
    }
   }
  }
 ],
 "src.tf": [
  {
   "file": "src.tf",
   "resource": {
    "aws_instance": {
     "src": {
      "probe_source": "fire"
     }
    }
   }
  }
 ]
}