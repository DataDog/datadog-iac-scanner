{
 "locals.tf": [
  {
   "file": "locals.tf",
   "locals": {
    "val": "${merge(aws_instance.src, { label = \"x\" })}"
   }
  }
 ],
 "neighbor.tf": [
  {
   "file": "neighbor.tf",
   "resource": {
    "aws_s3_bucket_versioning": {
     "rel": {
      "bucket": "${aws_s3_bucket.sink.id}",
      "versioning_configuration": {
       "status": "${var.unset_value}"
      }
     }
    }
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "probe": "${local.val}"
     }
    }
   }
  }
 ],
 "src.tf": [
  {
   "file": "src.tf",
   "resource": {
    "aws_instance": {
     "src": {
      "probe_source": "safe"
     }
    }
   }
  }
 ],
 "unset.tf": [
  {
   "file": "unset.tf",
   "variable": {
    "unset_value": {}
   }
  }
 ]
}