{
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "dynamic": {
       "d": {
        "content": {
         "inner": "${d.value}"
        },
        "for_each": "${var.unset}"
       }
      }
     }
    }
   }
  }
 ],
 "unset.tf": [
  {
   "file": "unset.tf",
   "variable": {
    "unset": {}
   }
  }
 ]
}