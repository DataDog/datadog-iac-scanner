{
 "locals.tf": [
  {
   "file": "locals.tf",
   "locals": {
    "src": {
     "probe_source": "fire"
    }
   }
  }
 ],
 "sink.tf": [
  {
   "file": "sink.tf",
   "resource": {
    "aws_s3_bucket": {
     "sink": {
      "computed_ref": "${aws_instance.src.id}",
      "probe": {
       "probe_source": "fire"
      }
     }
    }
   }
  }
 ],
 "src.tf": [
  {
   "file": "src.tf",
   "resource": {
    "aws_instance": {
     "src": {
      "probe_source": "fire"
     }
    }
   }
  }
 ]
}