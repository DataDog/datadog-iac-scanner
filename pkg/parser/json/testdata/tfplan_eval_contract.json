            "module": {
              "resources": [
                {
                  "address": "aws_s3_bucket.logs",
                  "expressions": {
                    "bucket": {
                      "references": [
                        "var.name"
                      ]
                    }
                  },
                  "mode": "managed",
                  "name": "logs",
                  "type": "aws_s3_bucket"
                }
              ]
            }
          }
        },
        "resources": [
          {
            "address": "aws_s3_bucket.logs",
            "expressions": {
              "bucket": {
                "constant_value": "logs-planned"
              }
            },
            "mode": "managed",
            "name": "logs",
            "type": "aws_s3_bucket"
          }
        ]
      }
    },
    "data": {
      "aws_iam_policy_document": {
        "read": {
          "json": "{}"
        }
      }
    },
    "resource": {
      "aws_instance": {
        "web[0]": {
          "ami": "ami-1",
          "vpc_security_group_ids": [
