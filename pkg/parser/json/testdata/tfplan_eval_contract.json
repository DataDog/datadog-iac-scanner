                  "references": [
                    "var.name"
                  ]
                }
              ],
              "references": [
                "var.name"
              ]
            }
          }
        }
      },
      "data.aws_iam_policy_document": {
        "read": {
          "address": "data.aws_iam_policy_document.read"
        }
      }
    },
    "configuration": {
      "root_module": {
        "module_calls": {
          "app": {
