          },
          "after_unknown": {
            "arn": true
          },
          "before": {
            "bucket": "logs-prior"
          }
        },
        "mode": "managed",
        "name": "logs",
        "type": "aws_s3_bucket"
      },
      {
        "address": "data.aws_iam_policy_document.old",
        "change": {
          "actions": [
            "delete"
          ]
        },
        "mode": "data",
